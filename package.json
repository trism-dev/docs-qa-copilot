{
  "name": "docs-qa-copilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "ingest:corpus": "node --env-file-if-exists=.env.local scripts/ingest-corpus.ts",
    "test": "node --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2"
  }
}
